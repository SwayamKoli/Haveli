# Easiest way to fill this in:   npm run setup     (or double-click setup.bat / run setup.sh in a customer folder)
# It asks a few questions, checks the Google connection and writes the ".env" file for you.
#
# Or copy this file to ".env" and fill it in by hand. Never share or commit ".env".

# 1. The Google Sheet: paste the whole sheet URL, or just the long id in it.
SHEET_ID=

# 2. The service account key. Paste the ENTIRE downloaded JSON file (several lines is fine)
#    inside single quotes:  GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account", ...}'
GOOGLE_SERVICE_ACCOUNT_JSON=

# 3. The OWNER password (8+ characters). Only the owner knows it.
#    It signs the owner in, opens any employee's account, and unlocks the Google Sheet link.
OWNER_PASSWORD=

# 4. Any long random text (24+ characters). Signs the login cookie.
#    Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 5. Shown on the sign-in screen and in the sidebar.
HOTEL_NAME=My Hotel

# Optional
# OWNER_USERNAME=owner           # what the owner types as the username (default: owner)
# OWNER_NAME=Owner               # the owner's name as it appears on bookings
# HOTEL_TIMEZONE=Asia/Kolkata
# PORT=3000
# MEDIA_DIR=./media             # where the owner's background photo/video is kept (back it up with this file)
# HOST=127.0.0.1                 # use 0.0.0.0 to open it from phones on the same Wi-Fi
#
# Employees are not set here. The owner adds them inside the app: Settings -> Employees.
# (APP_PASSWORD from version 0.1 still works as the owner password.)
