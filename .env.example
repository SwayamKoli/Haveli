# Easiest way to fill this in:   npm run setup     (or double-click setup.bat / run setup.sh in a customer folder)
# It asks a few questions, checks the Google connection and writes the ".env" file for you.
#
# Or copy this file to ".env" and fill it in by hand. Never share or commit ".env".

# 1. The Google Sheet: paste the whole sheet URL, or just the long id in it.
SHEET_ID=

# 2. The service account key. Paste the ENTIRE downloaded JSON file (several lines is fine)
#    inside single quotes:  GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account", ...}'
GOOGLE_SERVICE_ACCOUNT_JSON=

# 3. The OWNER password. Only the owner knows it. 8+ characters and not a common password;
#    12+ (a few unrelated words) if the app can be reached from other devices or the internet.
#    It signs the owner in, opens any employee's account, and unlocks the Google Sheet link.
OWNER_PASSWORD=

# 4. Any long random text (32+ characters). Signs the login cookie.
#    Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 5. Your hotel's name. It is the logo in the sidebar and on the sign-in screen, the welcome
#    animation and the browser tab title. Restart the app after changing it.
HOTEL_NAME=My Hotel

# Optional: the owner's 2-step code (strongly recommended on the web). Do not type this by hand:
#   run  npm run setup -- --2fa   (customer folder: node setup.mjs --2fa)  and it adds the line for you.
# OWNER_TOTP_SECRET=

# Optional
# OWNER_USERNAME=owner           # what the owner types as the username (default: owner)
# OWNER_NAME=Owner               # the owner's name as it appears on bookings
# HOTEL_TIMEZONE=Asia/Kolkata
# MEDIA_DIR=./media              # where the owner's background photo/video is kept (back it up with this file)

# Optional: running it on the web (see "Use it from anywhere" in README.md)
# PORT=3000                      # the port to listen on (hosting services set this for you)
# HOST=127.0.0.1                 # 127.0.0.1 = this computer only (default).
#                                #   0.0.0.0 = also other devices on the same Wi-Fi, or a public server
# ALLOWED_HOSTS=hotel.example.com  # answer only to these website names (comma separated)
# TRUST_PROXY=1                  # set to 1 when a host, tunnel or proxy (Caddy, Cloudflare, Render...) sits
#                                #   in front. Use 0 or leave out when people connect directly.
#                                #   With a long OWNER_PASSWORD (12+) and https only.
#
# Employees are not set here. The owner adds them inside the app: Settings -> Employees.
# (APP_PASSWORD from version 0.1 still works as the owner password.)
