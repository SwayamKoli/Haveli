# Copy this file to ".env" and fill it in. Never share or commit ".env".

# 1. The Google Sheet: paste the whole sheet URL, or just the long id in it.
SHEET_ID=

# 2. The service account key. Paste the ENTIRE downloaded JSON file on ONE line,
#    inside single quotes:  GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account", ...}'
GOOGLE_SERVICE_ACCOUNT_JSON=

# 3. The password staff type to sign in (8+ characters).
APP_PASSWORD=

# 4. Any long random text (24+ characters). Signs the login cookie.
#    Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional
# HOTEL_TIMEZONE=Asia/Kolkata
# STAFF_NAME=Front desk
# STAFF_ROLE=Reception
# VITE_HOTEL_NAME=Haveli Residency
# PORT=3000
# HOST=127.0.0.1        # use 0.0.0.0 to open it from phones on the same Wi-Fi
